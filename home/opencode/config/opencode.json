{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.dotfiles/home/shared/agent-instructions-core.md",
    "~/.config/opencode/AGENTS.md",
    "instructions/INSTRUCTIONS.md"
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-opencode-slim@3.0.5"
  ],
  "update": "auto",
  "model": "github-copilot/gpt-6-sol",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "github-copilot", "effect": "allow" },
    { "action": "integration.use", "resource": "mcp:google-drive", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:google-gmail", "effect": "deny" }
  ],
  "lsp": {
    "marksman": {
      "command": ["marksman", "server"],
      "extensions": [".md", ".markdown"]
    }
  },
  "share": "disabled",
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "skills": [
    "https://dev-tooling.on.com/skills/",
    "~/.local/share/incident-io-skills/plugins/incident-io/skills"
  ],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "read", "resource": "*.secret", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "todoread", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "codesearch", "resource": "*", "effect": "allow" },
    { "action": "atlassian_*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "doom_loop", "effect": "ask" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    "planner": {
      "description": "Expert planning specialist for complex features and refactoring. Use for implementation planning, architectural changes, or complex refactoring.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/planner.txt}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "architect": {
      "description": "Software architecture specialist for system design, scalability, and technical decision-making.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/architect.txt}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "code-reviewer": {
      "description": "Expert code review specialist. Reviews code for quality, security, and maintainability. Use immediately after writing or modifying code.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/code-reviewer.txt}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "security-reviewer": {
      "description": "Security vulnerability detection and remediation specialist. Use after writing code that handles user input, authentication, API endpoints, or sensitive data.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/security-reviewer.txt}"
    },
    "tdd-guide": {
      "description": "Test-Driven Development specialist enforcing write-tests-first methodology. Use when writing new features, fixing bugs, or refactoring code. Ensures 80%+ test coverage.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/tdd-guide.txt}"
    },
    "build-error-resolver": {
      "description": "Build and TypeScript error resolution specialist. Use when build fails or type errors occur. Fixes build/type errors only with minimal diffs.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/build-error-resolver.txt}"
    },
    "e2e-runner": {
      "description": "End-to-end testing specialist using Playwright. Generates, maintains, and runs E2E tests for critical user flows.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/e2e-runner.txt}"
    },
    "doc-updater": {
      "description": "Documentation and codemap specialist. Use for updating codemaps and documentation.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/doc-updater.txt}"
    },
    "refactor-cleaner": {
      "description": "Dead code cleanup and consolidation specialist. Use for removing unused code, duplicates, and refactoring.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/refactor-cleaner.txt}"
    },
    "database-reviewer": {
      "description": "PostgreSQL database specialist for query optimization, schema design, security, and performance. Incorporates Supabase best practices.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-sol",
      "system": "{file:prompts/agents/database-reviewer.txt}"
    },
    "title": {
      "model": "github-copilot/gpt-6-luna"
    }
  },
  "commands": {
    "tdd": {
      "description": "Enforce TDD workflow with 80%+ coverage",
      "template": "{file:commands/tdd.md}\n\n$ARGUMENTS"
    },
    "verify": {
      "description": "Run verification loop to validate implementation",
      "template": "{file:commands/verify.md}\n\n$ARGUMENTS"
    },
    "save-session": {
      "description": "Save current session to Obsidian vault",
      "template": "{file:commands/save-session.md}\n\n$ARGUMENTS"
    },
    "save-prompt": {
      "description": "Save a reusable prompt to Obsidian vault",
      "template": "{file:commands/save-prompt.md}\n\n$ARGUMENTS"
    },
    "new-skill": {
      "description": "Scaffold a new skill in the Obsidian vault",
      "template": "{file:commands/new-skill.md}\n\n$ARGUMENTS"
    },
    "new-project": {
      "description": "Create a new project in the Obsidian vault with optional per-repo OpenCode config",
      "template": "{file:commands/new-project.md}\n\n$ARGUMENTS"
    },
    "plan": {
      "description": "Create a detailed implementation plan for complex features",
      "template": "{file:commands/plan.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subagent": true
    },
    "code-review": {
      "description": "Review code for quality, security, and maintainability",
      "template": "{file:commands/code-review.md}\n\n$ARGUMENTS",
      "agent": "code-reviewer",
      "subagent": true
    },
    "security": {
      "description": "Run comprehensive security review",
      "template": "{file:commands/security.md}\n\n$ARGUMENTS",
      "agent": "security-reviewer",
      "subagent": true
    },
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:commands/build-fix.md}\n\n$ARGUMENTS",
      "agent": "build-error-resolver",
      "subagent": true
    },
    "e2e": {
      "description": "Generate and run E2E tests with Playwright",
      "template": "{file:commands/e2e.md}\n\n$ARGUMENTS",
      "agent": "e2e-runner",
      "subagent": true
    },
    "refactor-clean": {
      "description": "Remove dead code and consolidate duplicates",
      "template": "{file:commands/refactor-clean.md}\n\n$ARGUMENTS",
      "agent": "refactor-cleaner",
      "subagent": true
    },
    "orchestrate": {
      "description": "Orchestrate multiple agents for complex tasks",
      "template": "{file:commands/orchestrate.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subagent": true
    },
    "learn": {
      "description": "Extract patterns and learnings from session",
      "template": "{file:commands/learn.md}\n\n$ARGUMENTS"
    },
    "checkpoint": {
      "description": "Save verification state and progress",
      "template": "{file:commands/checkpoint.md}\n\n$ARGUMENTS"
    },
    "eval": {
      "description": "Run evaluation against criteria",
      "template": "{file:commands/eval.md}\n\n$ARGUMENTS"
    },
    "update-docs": {
      "description": "Update documentation",
      "template": "{file:commands/update-docs.md}\n\n$ARGUMENTS",
      "agent": "doc-updater",
      "subagent": true
    },
    "update-codemaps": {
      "description": "Update codemaps",
      "template": "{file:commands/update-codemaps.md}\n\n$ARGUMENTS",
      "agent": "doc-updater",
      "subagent": true
    },
    "test-coverage": {
      "description": "Analyze test coverage",
      "template": "{file:commands/test-coverage.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subagent": true
    },
    "setup-pm": {
      "description": "Configure package manager",
      "template": "{file:commands/setup-pm.md}\n\n$ARGUMENTS"
    },
    "go-review": {
      "description": "Go code review",
      "template": "{file:commands/go-review.md}\n\n$ARGUMENTS",
      "subagent": true
    },
    "go-test": {
      "description": "Go TDD workflow",
      "template": "{file:commands/go-test.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subagent": true
    },
    "go-build": {
      "description": "Fix Go build errors",
      "template": "{file:commands/go-build.md}\n\n$ARGUMENTS",
      "subagent": true
    },
    "skill-create": {
      "description": "Generate skills from git history",
      "template": "{file:commands/skill-create.md}\n\n$ARGUMENTS"
    },
    "instinct-status": {
      "description": "View learned instincts",
      "template": "{file:commands/instinct-status.md}\n\n$ARGUMENTS"
    },
    "instinct-import": {
      "description": "Import instincts",
      "template": "{file:commands/instinct-import.md}\n\n$ARGUMENTS"
    },
    "instinct-export": {
      "description": "Export instincts",
      "template": "{file:commands/instinct-export.md}\n\n$ARGUMENTS"
    },
    "evolve": {
      "description": "Cluster instincts into skills",
      "template": "{file:commands/evolve.md}\n\n$ARGUMENTS"
    },
    "promote": {
      "description": "Promote project instincts to global scope",
      "template": "{file:commands/promote.md}\n\n$ARGUMENTS"
    },
    "projects": {
      "description": "List known projects and instinct stats",
      "template": "{file:commands/projects.md}\n\n$ARGUMENTS"
    },
    "harness-audit": {
      "description": "Audit test harness configuration",
      "template": "{file:commands/harness-audit.md}\n\n$ARGUMENTS"
    },
    "loop-start": {
      "description": "Start autonomous development loop",
      "template": "{file:commands/loop-start.md}\n\n$ARGUMENTS"
    },
    "loop-status": {
      "description": "Check loop status",
      "template": "{file:commands/loop-status.md}\n\n$ARGUMENTS"
    },
    "quality-gate": {
      "description": "Run quality gate checks",
      "template": "{file:commands/quality-gate.md}\n\n$ARGUMENTS"
    },
    "model-route": {
      "description": "Route to optimal model for task",
      "template": "{file:commands/model-route.md}\n\n$ARGUMENTS"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "oauth": false
      },
      "websearch": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
        "oauth": false
      },
      "context-mode": {
        "type": "local",
        "command": [
          "context-mode"
        ]
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp"
      },
      "shopify-dev": {
        "type": "local",
        "command": ["npx", "-y", "@shopify/dev-mcp@latest"],
        "disabled": true
      },
      "contentful": {
        "type": "local",
        "command": ["npx", "-y", "@contentful/mcp-server"],
        "environment": {
          "CONTENTFUL_MANAGEMENT_ACCESS_TOKEN": "{env:CONTENTFUL_MANAGEMENT_TOKEN}",
          "SPACE_ID": "{env:CONTENTFUL_SPACE_ID}",
          "ENVIRONMENT_ID": "master"
        },
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "disabled": true
      },
      "newrelic": {
        "type": "remote",
        "url": "https://mcp.newrelic.com/mcp/",
        "headers": {
          "api-key": "{env:NEWRELIC_API_KEY}"
        },
        "oauth": false,
        "disabled": true
      },
      "incident-io": {
        "type": "remote",
        "url": "https://mcp.incident.io/mcp",
        "disabled": true
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "disabled": true
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "2540541395.10827271922499"
        },
        "disabled": true
      }
    }
  }
}
