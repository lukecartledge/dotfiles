{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "garmin": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/Taxuspt/garmin_mcp",
        "garmin-mcp"
      ],
      "enabled": false
    },
    "strava": {
      "command": "npx",
      "args": ["-y", "@r-huijts/strava-mcp-server"],
      "env": {
        "STRAVA_CLIENT_ID": "STRAVA_CLIENT_ID",
        "STRAVA_CLIENT_SECRET": "STRAVA_CLIENT_SECRET"
      },
      "enabled": false
    },
    "ibkr": {
      "command": "/Users/lukecartledge/code/personal/tools/mcp_claude_ibkr/venv/bin/python",
      "args": ["/Users/lukecartledge/code/personal/tools/mcp_claude_ibkr/ibkr_mcp.py"]
    }
  }
}
