{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {},
      "enabled": true
    },
    "newrelic": {
      "type": "http",
      "url": "https://mcp.newrelic.com/mcp/",
      "headers": {
        "api-key": "${NEWRELIC_API_KEY}"
      },
      "enabled": false
    },
    "amplitude": {
      "type": "http",
      "url": "https://mcp.eu.amplitude.com/mcp",
      "oauth": {},
      "enabled": false
    },
    "miro": {
      "type": "http",
      "url": "https://mcp.miro.com/",
      "enabled": false
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {},
      "enabled": false
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--headless"
      ],
      "enabled": false
    },
    "opslevel": {
      "type": "http",
      "url": "https://app.opslevel.com/mcp",
      "oauth": {},
      "enabled": false
    },
    "shopify-dev": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@shopify/dev-mcp@latest"
      ],
      "enabled": false
    },
    "incident-io": {
      "type": "http",
      "url": "https://mcp.incident.io/mcp",
      "oauth": {},
      "enabled": true
    },
    "google-gmail": {
      "type": "http",
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "289856961465-kuskbvg5hoanbh26mr21ul9oc7kflpta.apps.googleusercontent.com",
        "clientSecret": "${GOOGLE_MCP_CLIENT_SECRET}",
        "scope": "https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose"
      },
      "enabled": false
    },
    "google-drive": {
      "type": "http",
      "url": "https://drivemcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "289856961465-kuskbvg5hoanbh26mr21ul9oc7kflpta.apps.googleusercontent.com",
        "clientSecret": "${GOOGLE_MCP_CLIENT_SECRET}",
        "scope": "https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file"
      },
      "enabled": false
    },
    "google-calendar": {
      "type": "http",
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "289856961465-kuskbvg5hoanbh26mr21ul9oc7kflpta.apps.googleusercontent.com",
        "clientSecret": "${GOOGLE_MCP_CLIENT_SECRET}",
        "scope": "https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/calendar.events"
      },
      "enabled": false
    },
    "google-chat": {
      "type": "http",
      "url": "https://chatmcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "289856961465-kuskbvg5hoanbh26mr21ul9oc7kflpta.apps.googleusercontent.com",
        "clientSecret": "${GOOGLE_MCP_CLIENT_SECRET}",
        "scope": "https://www.googleapis.com/auth/chat.messages.readonly https://www.googleapis.com/auth/chat.spaces.readonly"
      },
      "enabled": false
    },
    "google-people": {
      "type": "http",
      "url": "https://people.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "289856961465-kuskbvg5hoanbh26mr21ul9oc7kflpta.apps.googleusercontent.com",
        "clientSecret": "${GOOGLE_MCP_CLIENT_SECRET}",
        "scope": "https://www.googleapis.com/auth/directory.readonly https://www.googleapis.com/auth/contacts.readonly"
      },
      "enabled": false
    },
    "bigquery": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server",
        "--prebuilt=bigquery",
        "--stdio"
      ],
      "env": {
        "BIGQUERY_PROJECT": "on-dp-prod-datamart",
        "GOOGLE_CLOUD_QUOTA_PROJECT": "on-dp-prod-datamart"
      },
      "enabled": false
    },
    "looker": {
      "type": "http",
      "url": "https://looker-byo-mcp-native-j7fhd3ua6a-ez.a.run.app/mcp",
      "oauth": {},
      "enabled": false
    },
    "cx-agent-studio": {
      "type": "http",
      "url": "https://ces.googleapis.com/mcp",
      "oauth": {},
      "enabled": false
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/mcp",
      "oauth": {},
      "enabled": false
    },
    "postman-eu": {
      "type": "http",
      "url": "https://mcp.eu.postman.com/mcp",
      "enabled": false
    },
    "postman-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@postman/postman-mcp-server@latest",
        "--minimal"
      ],
      "enabled": false
    },
    "sonarcloud": {
      "type": "http",
      "url": "https://api.sonarcloud.io/mcp",
      "headers": {
        "Authorization": "Bearer ${SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "on-running"
      },
      "enabled": false
    },
    "google-developer-knowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "oauth": {},
      "enabled": false
    },
    "aws-api": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "READ_OPERATIONS_ONLY": "true"
      },
      "enabled": false
    },
    "wiz": {
      "type": "http",
      "url": "https://mcp.app.wiz.io",
      "headers": {
        "X-Wiz-MCP-Mode": "gateway"
      },
      "enabled": false
    },
    "adk-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "mcpdoc==0.0.10",
        "mcpdoc",
        "--urls",
        "AgentDevelopmentKit:https://adk.dev/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": false
    },
    "rollbar": {
      "command": "mise",
      "args": [
        "exec",
        "node@24.18.0",
        "--",
        "npx",
        "-y",
        "@rollbar/mcp-server@latest"
      ],
      "env": {
        "ROLLBAR_ACCESS_TOKEN": "ROLLBAR_ACCESS_TOKEN"
      },
      "timeout": 30000,
      "enabled": false
    },
    "talon-one": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://onag.us-east4.talon.one/v1/mcp/entrypoint",
        "--header",
        "Authorization: Bearer ${MCP_AUTH_TOKEN}"
      ],
      "env": {
        "MCP_AUTH_TOKEN": "TALONONE_MCP_API_KEY"
      },
      "timeout": 30000,
      "enabled": false
    }
  }
}
