# Ghostty config — migrated from iTerm2 "Personal" profile
# Location: ~/.config/ghostty/config

# ── Font ──────────────────────────────────────────────────────────────────────
font-family = Operator Mono Lig
font-family-bold = Operator Mono Lig
font-family-italic = Operator Mono Lig
font-family-bold-italic = Operator Mono Lig
font-size = 14
font-feature = +liga
font-feature = +calt
adjust-cell-height = 10%
adjust-cell-width = 10%

# ── Colors (Cobalt2-derived "Personal" palette) ──────────────────────────────
background = 1b2935
foreground = ffffff
cursor-color = f1cc09
selection-background = 18344f
selection-foreground = f8f8f8

# ANSI normal
palette = 0=#000000
palette = 1=#ff0000
palette = 2=#38de21
palette = 3=#ff7420
palette = 4=#1478db
palette = 5=#ff005d
palette = 6=#00c5c7
palette = 7=#ffffff

# ANSI bright
palette = 8=#e6e6e6
palette = 9=#f50d0e
palette = 10=#3bcd1d
palette = 11=#ffed78
palette = 12=#6871ff
palette = 13=#ff77ff
palette = 14=#6ae3fa
palette = 15=#ffffff

# Bold color
bold-is-bright = false

# ── Cursor ────────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Window / Appearance ───────────────────────────────────────────────────────
background-opacity = 0.98
background-blur = 23
window-padding-x = 0
window-padding-y = 0
macos-titlebar-style = hidden
window-theme = dark
scrollbar = never

# ── Terminal Behavior ─────────────────────────────────────────────────────────
scrollback-limit = 0
term = xterm-256color
working-directory = ~/code
mouse-scroll-multiplier = 3

# ── Shell Integration ─────────────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ── Quick Terminal (replaces iTerm2 Ctrl+X hotkey window) ─────────────────────
# Keep Ghostty running in the background so the Quick Terminal stays
# accessible via the global hotkey even after closing all regular windows.
# (Default is already false on macOS; set explicitly for documentation.)
quit-after-last-window-closed = false

# Don't open a regular window on launch — Quick Terminal hotkey is the
# only entry point. Pair with a Login Item to have it ready at boot.
initial-window = false

quick-terminal-screen = macos-menu-bar
# NOTE: `global:` hotkeys need Accessibility permission (System Settings →
# Privacy & Security → Accessibility → enable Ghostty). This is per-machine
# and does NOT survive a new laptop or major macOS upgrade — re-grant it there.
# If the hotkey works only when Ghostty is focused, the grant is stale/missing:
#   1. Remove Ghostty from the Accessibility list, then `killall ghostty`
#   2. `sudo tccutil reset All com.mitchellh.ghostty`
#   3. Relaunch Ghostty and approve the prompt.
# (Ghostty ≤1.3.1 on macOS Tahoe can also silently disable the event tap after
#  sleep/unlock; a restart restores it until the post-1.3.1 fix ships.)
keybind = global:ctrl+x=toggle_quick_terminal
quick-terminal-size = 60%
quick-terminal-autohide = false

# ── Keybindings (macOS defaults are mostly fine, these add iTerm2 habits) ─────
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# The `global:ctrl+x` Quick Terminal hotkey above consumes ctrl+x system-wide,
# so no terminal app ever receives it. Claude Code needs a literal ctrl+x to
# delete a session from its /resume picker (press twice to confirm), and that
# handler is hardcoded — it has no action in ~/.claude/keybindings.json to
# remap. Send the raw ctrl+x byte (ASCII 0x18, CAN) instead, which leaves the
# global hotkey untouched.
keybind = super+shift+x=text:\x18
