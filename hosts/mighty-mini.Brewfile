cask_args appdir: '/Applications'

# Personal-machine tooling. Referenced by the personal Claude/OpenCode configs
# (settings.personal.json, opencode.personal.json), which the On-* work hosts
# do not link.

# uv — provides uvx, used to launch the garmin MCP server
brew 'uv'

# Claude Code — the claude package is only in hosts/mighty-mini.bash
cask 'claude-code@latest'
